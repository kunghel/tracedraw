<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "programs": the two programs, uploaded
     by each Windows build as the GitHub artifact
     "unsigned-programs-<build>" (windows-x86_64, windows-x86). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="tracedraw.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="tracedraw-cli.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
